# ZoneIQ HVAC Platform - Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zoneiq_db
DB_USER=zoneiq_user
DB_PASSWORD=your_secure_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
CORS_ORIGIN=http://localhost:3000
REQUEST_RATE_LIMIT=100
REQUEST_RATE_WINDOW=15

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Feature Flags
ENABLE_SWAGGER_DOCS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_QUERY_LOGGING=false
